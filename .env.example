# Copy this file to `.env` in the project root (same folder as package.json)
# and fill in the values. Never commit `.env`.

# Top-level Spectrum credentials (from your Photon dashboard).
PROJECT_ID=
PROJECT_SECRET=

# AI model: any OpenAI-compatible provider. Leave blank to run without AI
# (Phase 1 safety rules + "Thanks, I've noted that.").
# OpenCode Go + GLM-5.3:
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=
LLM_MODEL=glm-5.3

# Optional: on-call care-team phone (E.164) that receives triage alerts.
# On Free/Pro plans, register it as a project user in the Photon dashboard first.
CARE_TEAM_PHONE=

# Optional: where caregiver records are saved (default data/lucidity.json),
# and how long to wait for a burst of texts before replying (default 5000 ms).
# LUCIDITY_DATA_FILE=data/lucidity.json
# BURST_WINDOW_MS=5000

# Copy this file to `.env` in the project root (same folder as package.json)
# and fill in the values. Never commit `.env`.

# Top-level Spectrum credentials (from your Photon dashboard).
PROJECT_ID=
PROJECT_SECRET=

# AI model: any OpenAI-compatible provider. Leave blank to run without AI
# (Phase 1 safety rules + "Thanks, I've noted that.").
# OpenCode Go + GLM-5.3:
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=
LLM_MODEL=glm-5.3
# Optional: how much the model "thinks" before replying. Default is low
# (GLM-5.3 at its own default took 7-60s+ per reply; low takes ~2-8s).
# LLM_REASONING_EFFORT=low

# Optional: the clinician's phone (Lucidity Care, "Simulated clinician" in the demo).
# Texts from this number are clinician commands (PROFILE, ASK, RECOMMEND, APPROVE).
# Must be registered under Users in the Photon dashboard (Free/Pro plans).
CLINICIAN_PHONE=
# Optional: pin which caregiver the clinician works with (default: most recently active).
# DEMO_CAREGIVER_PHONE=

# Optional: on-call care-team phone (E.164) that receives triage alerts
# (defaults to CLINICIAN_PHONE).
# On Free/Pro plans, register it as a project user in the Photon dashboard first.
CARE_TEAM_PHONE=

# Optional: time zone for reminders ("8pm" means 8pm here). IANA name.
# LUCIDITY_TIMEZONE=America/New_York

# Optional: where caregiver records are saved (default data/lucidity.json),
# and how long to wait for a burst of texts before replying (default 10000 ms).
# LUCIDITY_DATA_FILE=data/lucidity.json
# BURST_WINDOW_MS=10000
